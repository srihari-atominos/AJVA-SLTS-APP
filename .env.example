# Copy this file to .env and adjust as needed.
# Every value here has a working default (see src/config/index.js) — you
# only need to set what you actually want to change.

# ---- Server ----
# NODE_ENV=development
# SERVER_PORT takes precedence over PORT if both are set (matches other prod apps' naming).
# PORT=4000
# SERVER_PORT=4000
# APP_NAME=SLTS
# Public URL this app is reachable at (used e.g. for building a SAML callback URL). HOST is a synonym.
# BACKEND_URL=
# DATA_DIR=./data
# XML_SOURCE_DIR=..
# Docker image tag prefix — not read by the app itself, only by docker-compose.yml.
# DOCKER_REGISTRY=

# ---- Auth ----
# SESSION_MAX_AGE_HOURS=12
# BCRYPT_ROUNDS=12
# PASSWORD_MIN_LENGTH=8
# Leave unset to auto-generate and persist one at <DATA_DIR>/.session-secret.
# Set explicitly if you ever run more than one server instance against the same DB.
# SESSION_SECRET=

# ---- Super Admin (optional: seed/update on every server start) ----
# Set both EMAIL and PASSWORD to auto-seed a Super Admin at startup instead
# of running `npm run create-super-admin` by hand. Safe to leave set after
# the first run: an existing Super Admin with this SAME email is just
# re-confirmed; a DIFFERENT existing Super Admin is left untouched (see
# src/features/users/superAdmin.js) rather than silently overwritten by a stale .env.
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_PASSWORD=
# false (default, recommended) = exactly one Super Admin ever exists.
# true = every distinct SUPER_ADMIN_EMAIL becomes its own Super Admin
# account instead of there being a single one. Real change to the security
# model — see README before enabling.
# SUPER_ADMIN_ALLOW_MULTIPLE=false

# ---- Database (SQLite by default; set DB_HOST to switch to MSSQL) ----
# Leaving DB_HOST unset keeps the local SQLite file (data/warranty.db) —
# zero extra server process, good for dev and small deployments. Setting
# DB_HOST (or DB_DRIVER=mssql explicitly) switches every repository to the
# MSSQL driver instead. See README's "Production: MSSQL Server" section —
# after setting these, run `npm run import:mssql` once to create the
# warranty-data tables and load them (the target database itself, e.g.
# "warranty", must already exist on the server — this only creates tables).
# DB_DRIVER=mssql
# DB_HOST=
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=
# DB_NAME=warranty
# SQL_ENCRYPT=false
# TRUST_CERTIFICATE=true
#
# At every server start the app creates any MISSING warranty data tables
# (vehicles/engines/transmissions/features/laborops — never drops or alters
# existing ones), so a brand-new database is immediately ready for XML
# uploads through the app (Admin > Upload). No data is loaded at startup.
# Set to false to opt out of the automatic table creation.
# DB_AUTO_SCHEMA=true

# ---- Windows SSO (on-prem Active Directory via native SSPI) ----
# Only works when this process runs directly on Windows (e.g. as a Windows
# Service) — NOT inside a Linux container, since SSPI is a native Windows
# API. If you're running this app via Docker on a Linux-based image, this
# stays harmlessly inactive (ssoAvailable: false) and SAML (below) is the
# SSO path to use instead. The handshake itself needs no credentials — it
# runs as whoever is signed into Windows. These only narrow or disable it.
# SSO_ENABLED=true
# Comma-separated Windows domain names allowed to SSO in, e.g. "CORP,CONTOSO".
# Empty (default) = accept any domain the handshake reports.
# SSO_ALLOWED_DOMAINS=

# ---- SAML SSO (federated — works from any container/OS, needs an IdP) ----
# For non-domain devices, or to federate through an existing enterprise IdP
# (ADFS/Entra/Okta/etc). On first successful SAML login for a never-seen
# email, an active Viewer account is auto-provisioned (the IdP's assertion
# is trusted proof of identity) — same "lands as Viewer, Admin promotes
# later" model as self-signup.
# ENABLE_SAML=false
# SAML_ENTRY_POINT=
# SAML_ISSUER=
# SAML_CALLBACK_URL=https://your-host/auth/saml/callback
# SAML_CERT=

# ---- Uploads ----
# UPLOAD_MAX_FILE_MB=50
# UPLOAD_MAX_FILES=20

# ---- Labor-time edit validation ----
# MAX_LABOR_HOURS=999

# ---- MongoDB (optional, only for `npm run import:mongo`) ----
# MONGO_URL=mongodb://127.0.0.1:27017
# MONGO_DB_NAME=warranty
# MONGO_BATCH_SIZE=2000

# ---- Email ----
# Not currently used — accounts are created via self-signup, no invite email.
# Left here for a future use (e.g. password reset). Leave SMTP_HOST unset to
# write any such email to data/outbox/*.txt instead of sending it.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=SLTS <no-reply@yourcompany.com>
