# escape=`
# Windows-container build of SLTS — for a Docker Engine on
# Windows Server 2022 that runs Windows containers (`docker info` shows
# "OSType: windows"). The existing ./Dockerfile is the Linux build; this is
# the same app, same port, same environment variables, on a Windows base.
#
#   docker compose -f docker-compose.windows.yml up -d --build
#
# Base-image rule: a Windows container's base must match the host's OS
# build family for the default process isolation. ltsc2022 = Windows Server
# 2022. On a newer host it still runs, but under Hyper-V isolation.
#
# Windows SSPI SSO is NOT enabled in this image (see --omit=optional below):
# inside a container the SSPI handshake needs a gMSA-joined container, which
# this deployment doesn't set up. Password and SAML login work as normal.

ARG NODE_VERSION=22.23.3
# SHA256 of node-v<NODE_VERSION>-win-x64.zip, from https://nodejs.org/dist/v<NODE_VERSION>/SHASUMS256.txt
ARG NODE_SHA256=2b0ff57b049cda1bbcea2240eec20467018713c1efe1f7360c2681859b90ed71

# ---- Stage 1: fetch Node and install dependencies (Server Core has PowerShell) ----
FROM mcr.microsoft.com/windows/servercore:ltsc2022 AS build
ARG NODE_VERSION
ARG NODE_SHA256
SHELL ["powershell", "-NoProfile", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

RUN $url = ('https://nodejs.org/dist/v{0}/node-v{0}-win-x64.zip' -f $env:NODE_VERSION); `
    Invoke-WebRequest -Uri $url -OutFile C:\node.zip; `
    $actual = (Get-FileHash C:\node.zip -Algorithm SHA256).Hash.ToLower(); `
    if ($actual -ne $env:NODE_SHA256.ToLower()) { throw ('Node zip SHA256 mismatch: expected {0}, got {1}' -f $env:NODE_SHA256, $actual) }; `
    Expand-Archive -Path C:\node.zip -DestinationPath C:\; `
    Rename-Item -Path ('C:\node-v{0}-win-x64' -f $env:NODE_VERSION) -NewName nodejs; `
    Remove-Item C:\node.zip

WORKDIR C:\app
COPY package.json package-lock.json ./
# --omit=dev: production deps only (same as the Linux image).
# --omit=optional: skips node-expose-sspi (native Windows SSO module) — see header.
# $ErrorActionPreference doesn't cover a native .cmd's exit code, so check it
# explicitly — otherwise a failed npm ci would still produce an image.
RUN C:\nodejs\npm.cmd ci --omit=dev --omit=optional; `
    if ($LASTEXITCODE -ne 0) { throw ('npm ci failed with exit code {0}' -f $LASTEXITCODE) }

# ---- Stage 2: runtime on Nano Server (small; no PowerShell, and none needed) ----
FROM mcr.microsoft.com/windows/nanoserver:ltsc2022

# Nano Server's default account (ContainerUser) can't reliably write to a
# mounted volume; the app writes data\.session-secret and data\outbox there.
USER ContainerAdministrator

COPY --from=build C:/nodejs C:/nodejs
WORKDIR C:\app
COPY --from=build C:/app/node_modules ./node_modules
COPY src ./src
COPY public ./public

# Stage 1's PowerShell SHELL doesn't carry over (and Nano Server has no PowerShell anyway).
SHELL ["cmd", "/S", "/C"]
# data\ is a volume (see docker-compose.windows.yml) — not baked into the image.
RUN mkdir data

ENV PATH="C:\nodejs;C:\Windows\system32;C:\Windows" `
    NODE_ENV=production
EXPOSE 5000

# Same check as the Linux image: a dead DB pool doesn't self-heal, so report
# unhealthy and let the restart layer cycle the container. Exec form, so no
# cmd.exe quoting is involved.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 `
  CMD ["node", "-e", "require('http').get('http://localhost:5000/health', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"]

CMD ["node", "src/server.js"]
